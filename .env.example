# Copy this file to .env and fill in the values.  NEVER commit .env.
#   cp .env.example .env

# ---------- Auth ----------
# "firebase" = real login with Firebase Auth (use this for your demo)
# "dev"      = no password, just type a name (only for local testing!)
AUTH_MODE=firebase
VITE_AUTH_MODE=firebase

# Firebase project (Console → Project settings → General → Your apps → Web app)
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---------- Database ----------
POSTGRES_USER=chat
POSTGRES_PASSWORD=change_me
POSTGRES_DB=chatdb
BOT_READER_PASSWORD=change_me_too

# ---------- Gemini (bot-service only — never put this in the client) ----------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# "gemini" for real use, "fake" for offline tests (no API calls)
LLM_PROVIDER=gemini

# Tables the bot may query for live data (comma separated)
BOT_SQL_TABLES=products,orders

# ---------- Chat server ----------
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
