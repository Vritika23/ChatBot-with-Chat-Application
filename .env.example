# Copy this file to .env and fill in the values.  NEVER commit .env.
#   cp .env.example .env

# ---------- Auth ----------
# "firebase" = real login with Firebase Auth (use this for your demo)
# "dev"      = no password, just type a name (only for local testing!)
AUTH_MODE=firebase
VITE_AUTH_MODE=firebase

# Firebase project (Console → Project settings → General → Your apps → Web app)
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---------- Database (local PostgreSQL + pgvector) ----------
# Must match the role/password you created in Postgres (see HOW_TO_RUN.md, first-time setup)
DATABASE_URL=postgresql://chat:chat_dev_password@localhost:5432/chatdb
# Read-only login the bot uses for live-data SQL (created by db/02-readonly-role.sh)
READONLY_DATABASE_URL=postgresql://bot_reader:bot_reader_dev@localhost:5432/chatdb
# Used by db/02-readonly-role.sh when it creates the bot_reader role
POSTGRES_DB=chatdb
BOT_READER_PASSWORD=bot_reader_dev

# ---------- Kafka ----------
KAFKA_BROKERS=localhost:9092

# ---------- Gemini (bot-service only — never put this in the client) ----------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Backup chat models, comma separated, tried in order when the main one is overloaded (503), over its quota (429) or times out.
# Free tier = about 20 requests/day PER MODEL, and each bot answer uses 2, so a longer chain keeps the bot working.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# "gemini" for real use, "fake" for offline tests (no API calls)
LLM_PROVIDER=gemini

# Tables the bot may query for live data (comma separated)
BOT_SQL_TABLES=products,orders

# ---------- Chat server ----------
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Where chat-server reaches bot-service (document upload/list/delete)
BOT_SERVICE_URL=http://localhost:8000
